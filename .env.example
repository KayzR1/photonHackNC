# Spectrum Cloud project (https://app.photon.codes/dashboard — promo code HACKWITHPHOTON)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Anthropic API key for the judge model
ANTHROPIC_API_KEY=

# Optional overrides (all in milliseconds unless noted)
# How long a party has to respond before a default judgment is entered against them.
HUNG_JURY_TIMEOUT_MS=90000
# How long the jury has to tapback-vote in open court.
HUNG_JURY_VOTE_WINDOW_MS=90000
# SQLite file path for case + precedent storage.
HUNG_JURY_DB_PATH=./hung-jury.db
